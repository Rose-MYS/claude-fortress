      "tier": "high",
      "priority": 2,
      "strengths": ["multi-file engineering", "refactoring", "script + test verification"],
      "quota_hint": "available",
      "notes": "Complex multi-step tasks and cross-verification"
    },
    "autoclaw": {
      "display_name": "AutoClaw (zcode)",
