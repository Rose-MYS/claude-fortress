{
  "routing_policy": {
    "default_stance": "claude_first",
    "autonomous_dispatch_trigger": "host_only_capabilities",
    "autonomous_dispatch_mode": "confirm_before_dispatch",
    "anti_relay_rule": "require_clear_spec_and_post_verification",
    "on_failure_or_rate_limit": "pause_and_ask_user",
    "note": "Default to doing regular tasks directly inside the guest agent. Propose host dispatch autonomously only for host-only capabilities, and always wait for explicit user approval before calling host_dispatch."
  },
